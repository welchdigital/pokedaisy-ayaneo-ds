+package com.pokedaisy.app
+
+import android.app.Activity
+import android.app.ActivityOptions
+import android.content.Context
+import android.content.Intent
+import android.graphics.Color
+import android.os.Build
+import android.os.Bundle
+import android.os.SystemClock
+import android.util.Log
+import android.view.KeyEvent
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.FrameLayout
+import androidx.core.view.WindowCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.WindowInsetsControllerCompat
+import androidx.lifecycle.setViewTreeLifecycleOwner
+import androidx.lifecycle.setViewTreeViewModelStoreOwner
+import androidx.savedstate.setViewTreeSavedStateRegistryOwner
+
+/** The second screen's window, whichever kind [PokeDaisyActivity] has up: a [DualScreenPresentation] or a [SecondScreenActivity]. */
+interface SecondScreenWindow {
+    /** The display it's on (or was asked for). */
+    val screenId: Int
+
+    /** Up on that display; an activity Android is still starting counts, for a moment. */
+    val showing: Boolean
+
+    /** Takes it down and lets go of its content (the game's stage, on its way back to the game's activity). */
+    fun close()
+}
+
+/**
+ * The second screen as an activity of its own, for a display a [DualScreenPresentation] can't go on: the device's
+ * default display (WindowManager never puts TYPE_PRESENTATION there) or one without the presentation flag.
+ *
+ * The AYANEO Pocket DS is why. Its default display is the small bottom screen, and its big top screen is a second
+ * display, so with the game up top ([Screens.mainId]) the companion's screen is the default one. A Presentation can't
+ * go there, so the companion goes down as this activity instead: its own task, launched on that display. Gen 1 Recomp
+ * does the same on the Pocket DS, and its second screen works there. (A Presentation on the bottom screen was never an
+ * option, and the Pocket DS also keeps its own menu over the bottom screen until an app is started there.)
+ *
+ * It shows what a Presentation would ([Window.content], built in this activity's context) and hands every key and
+ * stick motion to the game's activity, as [DualScreenPresentation] does.
+ */
+class SecondScreenActivity : Activity() {
+
+    /**
+     * One second-screen window asked of this activity: [content] on display [screenId], for [host] (the game's activity,
+     * which gets the keys). Made at once, handed to the activity when Android starts it. [onLost] hears when the activity
+     * went away without being [close]d: stopped (another app, or the device's own menu, over it), destroyed, or started
+     * on another display than the one asked for. A lost window stays lost; the host asks for a new one.
+     */
+    class Window(
+        private val host: Activity,
+        override val screenId: Int,
+        val content: (Context) -> View,
+        private val onLost: (Window) -> Unit,
+    ) : SecondScreenWindow {
+        internal var activity: SecondScreenActivity? = null
+        private var closed = false
+        private var lost = false
+
+        /** When the activity first showed it (0 = not yet): a window lost soon after is a failed start, not a player's close. */
+        var shownAt = 0L
+            internal set
+
+        /** Asked for or up: every way it can go away without [close] marks it lost ([lose]). */
+        override val showing: Boolean get() = !closed && !lost
+
+        /** Asks Android for the activity on [screenId]; false = it refused at once. */
+        fun launch(): Boolean {
+            waiting = this
+            return runCatching {
+                host.startActivity(
+                    Intent(host, SecondScreenActivity::class.java)
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_NO_ANIMATION),
+                    ActivityOptions.makeBasic().setLaunchDisplayId(screenId).toBundle(),
+                )
+                Log.i(TAG, "second screen activity asked for on display $screenId")
+                // Android can also drop the start without a word: not up in a few seconds = lost.
+                host.window.decorView.postDelayed({ if (activity == null) lose("never started") }, START_TIMEOUT_MS)
+            }.onFailure {
+                Log.w(TAG, "second screen activity refused on display $screenId", it)
+                if (waiting === this) waiting = null
+                lost = true
+            }.isSuccess
+        }
+
+        override fun close() {
+            if (closed) return
+            closed = true
+            if (waiting === this) waiting = null
+            activity?.let { a ->
+                activity = null
+                a.release()
+                a.finish()
+            }
+        }
+
+        internal val isClosed get() = closed
+
+        internal fun lose(why: String) {
+            if (closed || lost) return
+            lost = true
+            if (waiting === this) waiting = null
+            Log.i(TAG, "second screen activity on display $screenId went away: $why")
+            onLost(this)
+        }
+
+        /** The host forwards keys here: true while the activity is up and Android gives it the keys. */
+        internal fun key(event: KeyEvent): Boolean = host.dispatchKeyEvent(event)
+
+        internal fun motion(event: MotionEvent): Boolean = host.dispatchGenericMotionEvent(event)
+    }
+
+    private val owner = ComposeHostOwner()
+    private var frame: FrameLayout? = null
+    private var shown: Window? = null
+
+    /** Started and not stopped: it's on its display. */
+    internal var isUp = false
+        private set
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        owner.create()
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        frame = FrameLayout(this).apply {
+            setBackgroundColor(Color.BLACK)
+            setViewTreeLifecycleOwner(owner)
+            setViewTreeSavedStateRegistryOwner(owner)
+            setViewTreeViewModelStoreOwner(owner)
+        }
+        setContentView(frame!!)
+        goFullScreen()
+        attach()
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        attach()
+    }
+
+    /** Takes the window that's waiting, if it's for this display. Nothing waiting = nothing to show here. */
+    private fun attach() {
+        val want = waiting
+        if (want == null || want.isClosed) {
+            if (shown == null) finish()
+            return
+        }
+        if (want === shown) return
+        val here = Screens.displayOf(this)
+        if (want.screenId != here) {
+            // Android put it on another display (over the game, perhaps): not there.
+            want.lose("started on display $here, not ${want.screenId}")
+            if (shown == null) finish()
+            return
+        }
+        waiting = null
+        // An older window this activity showed: the host closed it before asking for the new one.
+        shown?.let { if (it.activity === this) it.activity = null }
+        release()
+        shown = want
+        want.activity = this
+        frame?.addView(want.content(this).also { (it.parent as? ViewGroup)?.removeView(it) })
+        if (isUp && want.shownAt == 0L) want.shownAt = SystemClock.uptimeMillis()
+        Log.i(TAG, "second screen activity shown on display $here (${Screens.describe(this, here)})")
+    }
+
+    /** Lets go of the content (the game's stage, on its way back to the game's activity). */
+    internal fun release() {
+        frame?.removeAllViews()
+    }
+
+    override fun onStart() {
+        super.onStart()
+        isUp = true
+        owner.resume()
+        goFullScreen()
+        shown?.let { if (it.shownAt == 0L) it.shownAt = SystemClock.uptimeMillis() }
+    }
+
+    override fun onStop() {
+        super.onStop()
+        isUp = false
+        // Covered (another app, HOME on this screen, the device's own menu): the game's activity decides what's next.
+        if (!isFinishing && !isChangingConfigurations) shown?.lose("stopped")
+    }
+
+    override fun onDestroy() {
+        shown?.let { w ->
+            if (w.activity === this) w.activity = null
+            w.lose("destroyed")
+        }
+        shown = null
+        release()
+        owner.destroy()
+        super.onDestroy()
+    }
+
+    override fun onWindowFocusChanged(hasFocus: Boolean) {
+        super.onWindowFocusChanged(hasFocus)
+        if (hasFocus) goFullScreen()
+    }
+
+    /**
+     * Keys belong to the game: once this screen is touched (or started) it holds the key focus, and the controls would
+     * otherwise land here. BACK goes too (tap = the companion's back, hold = the library), as from the Presentation.
+     */
+    override fun dispatchKeyEvent(event: KeyEvent): Boolean =
+        shown?.key(event) ?: super.dispatchKeyEvent(event)
+
+    override fun dispatchGenericMotionEvent(event: MotionEvent): Boolean =
+        shown?.motion(event) ?: super.dispatchGenericMotionEvent(event)
+
+    /** No status bar or navigation bar on the companion's screen; an edge swipe shows them for a moment. */
+    private fun goFullScreen() {
+        val w = window ?: return
+        WindowCompat.setDecorFitsSystemWindows(w, false)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            w.attributes = w.attributes.apply {
+                layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
+            }
+        }
+        WindowCompat.getInsetsController(w, w.decorView).apply {
+            systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+            hide(WindowInsetsCompat.Type.systemBars())
+        }
+    }
+
+    companion object {
+        private const val TAG = "pokedaisy"
+
+        /** How long Android gets to start the activity before its window counts as lost. */
+        private const val START_TIMEOUT_MS = 3_000L
+
+        /** The window the next started (or re-started) activity shows. Main thread only. */
+        private var waiting: Window? = null
+    }
+}
